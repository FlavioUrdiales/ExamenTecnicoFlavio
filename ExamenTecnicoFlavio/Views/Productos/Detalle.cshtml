@model ExamenTecnicoFlavio.Models.DetalleProductoViewModel

@{
    ViewData["Title"] = "Órdenes del producto";
}

<div class="container mt-4">


    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["MensajeExito"]
        </div>
    }

    <h2>Órdenes del producto</h2>

    <h4 class="text-primary">@Model.NombreProducto</h4>

    <p class="text-muted">
        Total de detalles de venta: @Model.TotalRegistros
    </p>

    <a asp-controller="Productos"
       asp-action="Index"
       class="btn btn-secondary mb-3">
        Volver a productos
    </a>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>SalesOrderID</th>
                    <th>Fecha de orden</th>
                    <th>Cantidad</th>
                    <th>Precio unitario</th>
                    <th>CarrierTrackingNumber</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var orden in Model.Ordenes)
                {
                    <tr>
                        <td>@orden.SalesOrderID</td>
                        <td>@orden.FechaOrden.ToString("dd/MM/yyyy")</td>
                        <td>@orden.Cantidad</td>
                        <td>@orden.PrecioUnitario.ToString("N2")</td>
                        <td>@(orden.CarrierTrackingNumber ?? "Sin asignar")</td>
                        <td>

                            <a asp-controller="Productos"
                               asp-action="EditarTracking"
                               asp-route-salesOrderId="@orden.SalesOrderID"
                               asp-route-salesOrderDetailId="@orden.SalesOrderDetailID"
                               class="btn btn-outline-primary btn-sm">
                                Editar
                            </a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Paginación de órdenes">
            <ul class="pagination justify-content-center">

                <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Detalle"
                       asp-route-id="@Model.ProductID"
                       asp-route-pagina="@(Model.PaginaActual - 1)">
                        Anterior
                    </a>
                </li>

                @for (int i = Math.Max(1, Model.PaginaActual - 2);
                      i <= Math.Min(Model.TotalPaginas, Model.PaginaActual + 2);
                      i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link"
                           asp-action="Detalle"
                           asp-route-id="@Model.ProductID"
                           asp-route-pagina="@i">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Detalle"
                       asp-route-id="@Model.ProductID"
                       asp-route-pagina="@(Model.PaginaActual + 1)">
                        Siguiente
                    </a>
                </li>

            </ul>
        </nav>
    }

    <div class="text-center text-muted mb-3">
        Página @Model.PaginaActual de
        @Math.Max(1, Model.TotalPaginas)
        — @Model.TotalRegistros registros
    </div>


    @if (!Model.Ordenes.Any())
    {
        <div class="alert alert-info">
            Este producto no tiene órdenes de venta.
        </div>
    }

</div>
