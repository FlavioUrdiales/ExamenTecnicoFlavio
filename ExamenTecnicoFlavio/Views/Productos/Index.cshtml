@model List<ExamenTecnicoFlavio.Models.ProductoVendido>

@{
    ViewData["Title"] = "Prductos";
}

<div class="container mt-4">

    <p class="text-muted">
        Top 5 de productos con mayor cantidad vendida.
    </p>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Producto</th>
                <th>Cantidad vendida</th>
                <th>Monto total vendido</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var producto in Model)
            {
                <tr>
                    <td>@producto.NombreProducto</td>
                    <td>@producto.CantidadVendida.ToString("N0")</td>
                    <td>@producto.MontoTotalVendido.ToString("N2")</td>
                    <td>
                        <a asp-controller="Productos"
                           asp-action="Detalle"
                           asp-route-id="@producto.ProductID"
                           class="btn btn-primary btn-sm">
                            Ver órdenes
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
